# Copy to .env.staging.activation only during an explicitly authorized test
# window. Keep the real file mode 600 and never commit or print its values.
# Generate the HMAC value from at least 32 random bytes; this example requires
# the repository-standard 64-character hexadecimal representation.
PENDING_REGISTRATION_TOKEN_HMAC_KEY=GENERATE_STAGING_ONLY_64_HEX_SECRET
REGISTRATION_DEPLOYMENT_ID=staging-onboarding-YYYYMMDD-APP_SHA_SEQUENCE
