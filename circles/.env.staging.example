# Kamooni staging environment template (contains no secrets).
# NEVER copy production secrets here. Generate new staging-only values.
# Do not commit real .env or .env.staging files.
# CIRCLES_URL must remain staging.kamooni.org before any media upload.
# Postmark, Telegram, payments, VibeID, and OpenAI remain disabled initially.
# Mapbox requires a staging/test browser token if map testing is later enabled.

# Fixed staging identity and internal service discovery.
CIRCLES_DOMAIN=staging.kamooni.org
CIRCLES_INSTANCE_NAME=Kamooni Staging
CIRCLES_NODE_ENV=production
CIRCLES_HOST=circles
CIRCLES_PORT=3000
NODE_ENV=production

MONGO_HOST=db
MONGO_PORT=27017
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_BUCKET=circles
MINIO_PRIVATE_BUCKET=circles-private

CIRCLES_URL=https://staging.kamooni.org
NEXT_PUBLIC_APP_URL=https://staging.kamooni.org
NEXT_PUBLIC_SITE_URL=https://staging.kamooni.org
NEXT_PUBLIC_CHAT_PROVIDER=mongo
NEXT_PUBLIC_MAINTENANCE_MODE=false

VDB_ENABLED=false
LOCAL_FS_STORAGE=false
PAYMENTS_ENABLED=false

# Generate unique staging-only values for every placeholder below.
MONGO_ROOT_USERNAME=GENERATE_STAGING_ONLY_USERNAME
MONGO_ROOT_PASSWORD=GENERATE_STAGING_ONLY_PASSWORD
# Must use host db, database circles, and authSource=admin. URL-encode credentials.
MONGODB_URI=mongodb://GENERATE_STAGING_ONLY_USERNAME:GENERATE_STAGING_ONLY_PASSWORD@db:27017/circles?authSource=admin
MINIO_ROOT_USERNAME=GENERATE_STAGING_ONLY_USERNAME
MINIO_ROOT_PASSWORD=GENERATE_STAGING_ONLY_PASSWORD
CIRCLES_JWT_SECRET=GENERATE_STAGING_ONLY_SECRET
CRON_SECRET=GENERATE_STAGING_ONLY_SECRET
ALTCHA_HMAC_KEY=GENERATE_STAGING_ONLY_SECRET
TELEGRAM_WEBHOOK_SECRET=GENERATE_STAGING_ONLY_SECRET

# Disabled integrations. Leave blank for the initial staging deployment.
CIRCLES_REGISTRY_URL=
OPENAI_API_KEY=
MAPBOX_API_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=
POSTMARK_API_TOKEN=
POSTMARK_SENDER_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
DONORBOX_EMAIL=
DONORBOX_API_USER=
DONORBOX_API_KEY=
DONORBOX_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_PRICE_MONTHLY_1=
STRIPE_PRICE_MONTHLY_2=
STRIPE_PRICE_MONTHLY_5=
STRIPE_PRICE_MONTHLY_10=
VIBE_ID_CREDENTIAL_ISSUER_PRIVATE_JWK=
# Legacy application fallback; Compose also forcibly clears it.
KAMOONI_VIBE_ID_ISSUER_PRIVATE_JWK=
VIBE_ID_CREDENTIAL_ISSUER_DID=
VIBE_ID_CREDENTIAL_ISSUER_NAME=
VIBE_ID_CREDENTIAL_ISSUER_TAGLINE=

# Matrix remains disabled. Blank values only satisfy Compose interpolation.
SYNAPSE_POSTGRES_USERNAME=
SYNAPSE_POSTGRES_PASSWORD=
