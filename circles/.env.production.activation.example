# Copy outside the Git checkout as /root/circles/onboarding-secrets/activation.env.
# Keep the real file root-owned and mode 600. Never commit or print its values.
# Generate the HMAC from at least 32 random bytes and keep it separate from
# ALTCHA, JWT, cron, MinIO, Mongo, and routing-operator credentials.
PENDING_REGISTRATION_TOKEN_HMAC_KEY=GENERATE_PRODUCTION_ONLY_64_HEX_SECRET
REGISTRATION_DEPLOYMENT_ID=production-onboarding-YYYYMMDD-APP_SHA_SEQUENCE
